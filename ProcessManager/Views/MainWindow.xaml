<Window x:Class="ProcessManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        xmlns:models="clr-namespace:ProcessManager.Models"
        xmlns:local="clr-namespace:ProcessManager.ViewModels"
        Title="Диспетчер процессов" 
        Height="900" 
        Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="#F0F0F0"
        FontFamily="Segoe UI">

    <Window.DataContext>
        <local:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Стили -->
        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TreeView">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="False"/>
            <Setter Property="Foreground" Value="Black"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Priority}" Value="High">
                    <Setter Property="Background" Value="#E8F5E9"/>
                    <Setter Property="Foreground" Value="Black"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Priority}" Value="RealTime">
                    <Setter Property="Background" Value="#FFEBEE"/>
                    <Setter Property="Foreground" Value="Black"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Priority}" Value="Idle">
                    <Setter Property="Foreground" Value="#666666"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="AlternatingRowBackground" Value="#F5F5F5"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Priority}" Value="High">
                    <Setter Property="Background" Value="#E8F5E9"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Priority}" Value="RealTime">
                    <Setter Property="Background" Value="#FFEBEE"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Priority}" Value="Idle">
                    <Setter Property="Foreground" Value="#666666"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2C3E50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="5,0"/>
        </Style>

        <Style TargetType="Border" x:Key="ChartBorder">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>

        <!-- Шаблон для отображения процессов в дереве -->
        <HierarchicalDataTemplate DataType="{x:Type models:ProcessInfo}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="2">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,5,0"/>
                <TextBlock Text="(" Foreground="Gray"/>
                <TextBlock Text="{Binding Id}" Foreground="Blue"/>
                <TextBlock Text=") " Foreground="Gray"/>
                <TextBlock Text="{Binding MemoryMb}" Foreground="Green"/>
            </StackPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="250"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель инструментов -->
        <WrapPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBox Width="250" 
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                     ToolTip="Поиск по имени процесса"/>

            <CheckBox Content="Только GUI" 
                      IsChecked="{Binding OnlyGui}"/>

            <CheckBox Content="Системные" 
                      IsChecked="{Binding OnlySystem}"/>

            <Button Content="Обновить (F5)" 
                    Command="{Binding RefreshCommand}"
                    Background="#3498DB"
                    Style="{StaticResource ActionButton}"/>

            <Border Background="White"
                    BorderBrush="#CCCCCC"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="5,0"
                    Margin="10,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Обновление:" 
                              VerticalAlignment="Center"
                              Margin="5,0"/>

                    <TextBox Text="{Binding UpdateInterval, UpdateSourceTrigger=PropertyChanged}"
                            Width="50"
                            Padding="3"
                            Margin="5,0"
                            HorizontalContentAlignment="Center"
                            MaxLength="3"/>

                    <TextBlock Text="сек" 
                              VerticalAlignment="Center"
                              Margin="0,0,5,0"/>
                </StackPanel>
            </Border>

            <Button Content="?" 
                    Command="{Binding ShowHelpCommand}"
                    Width="35"
                    Height="35"
                    Background="#95A5A6"
                    FontWeight="Bold"
                    FontSize="16"
                    Margin="10,0,0,0"
                    ToolTip="Справка (F1)"
                    Style="{StaticResource ActionButton}"/>
        </WrapPanel>

        <!-- Основная область с двумя панелями -->
        <Grid Grid.Row="1" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <!-- Таблица процессов -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Список процессов" 
                          FontWeight="SemiBold" 
                          FontSize="14"
                          Margin="0,0,0,5"/>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Processes}"
                          SelectedItem="{Binding SelectedProcess}">

                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Завершить процесс" Command="{Binding KillCommand}">
                                <MenuItem.Icon>
                                    <TextBlock Text="❌" FontSize="14"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="Приоритет">
                                <MenuItem Header="Обычный" Command="{Binding SetNormalPriorityCommand}"/>
                                <MenuItem Header="Высокий" Command="{Binding SetHighPriorityCommand}"/>
                                <MenuItem Header="Реального времени" Command="{Binding SetRealtimePriorityCommand}"/>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="Применить affinity" Command="{Binding ApplyAffinityCommand}"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="PID" 
                                           Binding="{Binding Id}" 
                                           Width="60"/>

                        <DataGridTextColumn Header="Имя процесса" 
                                           Binding="{Binding Name}" 
                                           Width="150"/>

                        <DataGridTextColumn Header="Приоритет" 
                                           Binding="{Binding PriorityDisplay}" 
                                           Width="100"/>

                        <DataGridTextColumn Header="Память" 
                                           Binding="{Binding MemoryMb}" 
                                           Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style>
                                    <Setter Property="TextBlock.TextAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Потоки" 
                                           Binding="{Binding ThreadCount}" 
                                           Width="60">
                            <DataGridTextColumn.ElementStyle>
                                <Style>
                                    <Setter Property="TextBlock.TextAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Время CPU" 
                                           Binding="{Binding CpuTime, StringFormat={}{0:hh\\:mm\\:ss}}" 
                                           Width="90"/>

                        <DataGridCheckBoxColumn Header="Окно" 
                                               Binding="{Binding HasWindow}" 
                                               Width="50"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- Дерево процессов -->
            <Grid Grid.Column="1" Margin="10,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Дерево процессов" 
                          FontWeight="SemiBold" 
                          FontSize="14"
                          Margin="0,0,0,5"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <TreeView ItemsSource="{Binding ProcessTree}"
                             SelectedItemChanged="TreeView_SelectedItemChanged"
                             BorderThickness="1"
                             BorderBrush="#CCCCCC"
                             Background="White">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="True"/>
                                <Setter Property="Foreground" Value="Black"/>
                                <EventSetter Event="MouseRightButtonDown" Handler="TreeViewItem_MouseRightButtonDown"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Нижняя панель с графиками -->
        <Grid Grid.Row="2" Margin="0,10,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <!-- График CPU -->
            <Border Grid.Column="0" 
                    Style="{StaticResource ChartBorder}"
                    Margin="0,0,5,0"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Загрузка процессора (%)" 
                              FontWeight="SemiBold" 
                              Margin="0,0,0,10"
                              FontSize="13"/>

                    <lvc:CartesianChart Grid.Row="1" 
                                       Series="{Binding CpuSeries}"
                                       Hoverable="True"
                                       DisableAnimations="True">
                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis MinValue="0" 
                                     MaxValue="100"
                                     Title="%"
                                     FontSize="10"/>
                        </lvc:CartesianChart.AxisY>
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis IsEnabled="False"/>
                        </lvc:CartesianChart.AxisX>
                    </lvc:CartesianChart>
                </Grid>
            </Border>

            <!-- График памяти -->
            <Border Grid.Column="1" 
                    Style="{StaticResource ChartBorder}"
                    Margin="5,0"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Использование памяти (топ 10)" 
                              FontWeight="SemiBold" 
                              Margin="0,0,0,10"
                              FontSize="13"/>

                    <lvc:PieChart Grid.Row="1" 
                                 Series="{Binding MemorySeries}"
                                 Hoverable="True"
                                 InnerRadius="30"/>
                </Grid>
            </Border>

            <!-- Панель Affinity -->
            <Border Grid.Column="2" 
                    Style="{StaticResource ChartBorder}"
                    Margin="5,0,0,0"
                    Padding="10">
                <StackPanel>
                    <TextBlock Text="Привязка к ядрам (Affinity)" 
                              FontWeight="SemiBold" 
                              Margin="0,0,0,15"
                              FontSize="13"/>

                    <StackPanel Margin="0,0,0,15">
                        <WrapPanel>
                            <CheckBox Content="Core 0" IsChecked="{Binding Cores[0]}" Margin="0,0,15,5"/>
                            <CheckBox Content="Core 1" IsChecked="{Binding Cores[1]}" Margin="0,0,15,5"/>
                            <CheckBox Content="Core 2" IsChecked="{Binding Cores[2]}" Margin="0,0,15,5"/>
                            <CheckBox Content="Core 3" IsChecked="{Binding Cores[3]}" Margin="0,0,15,5"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,5,0,0">
                            <CheckBox Content="Core 4" IsChecked="{Binding Cores[4]}" Margin="0,0,15,5"/>
                            <CheckBox Content="Core 5" IsChecked="{Binding Cores[5]}" Margin="0,0,15,5"/>
                            <CheckBox Content="Core 6" IsChecked="{Binding Cores[6]}" Margin="0,0,15,5"/>
                            <CheckBox Content="Core 7" IsChecked="{Binding Cores[7]}" Margin="0,0,15,5"/>
                        </WrapPanel>
                    </StackPanel>

                    <Button Content="Применить affinity" 
                            Command="{Binding ApplyAffinityCommand}"
                            Background="#27AE60"
                            Foreground="White"
                            HorizontalAlignment="Center"
                            Margin="0,15"
                            Padding="20,8"
                            Style="{StaticResource ActionButton}"/>

                    <TextBlock Text="{Binding AffinityHex}" 
                              FontFamily="Consolas"
                              FontSize="11"
                              HorizontalAlignment="Center"
                              Foreground="#27AE60"
                              Margin="0,2"/>
                    <TextBlock Text="{Binding AffinityBin}" 
                              FontFamily="Consolas"
                              FontSize="11"
                              HorizontalAlignment="Center"
                              Foreground="#27AE60"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Статус бар -->
        <StatusBar Grid.Row="3" Background="#2C3E50" Foreground="White" Padding="5">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding CoreCount, StringFormat=Ядер: {0}}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>